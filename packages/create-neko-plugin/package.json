{
  "name": "@nekotech/create-neko-plugin",
  "type": "module",
  "version": "0.11.4",
  "description": "Scaffolding CLI generator and registry linter for NekoAI application plugins",
  "author": {
    "name": "NekoTech Team",
    "email": "airi@moeru.ai",
    "url": "https://github.com/moeru-ai"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nekoo-moe/NekoAI.git",
    "directory": "packages/create-neko-plugin"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./scaffold": {
      "types": "./dist/scaffold.d.mts",
      "default": "./dist/scaffold.mjs"
    },
    "./linter": {
      "types": "./dist/linter.d.mts",
      "default": "./dist/linter.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "bin": {
    "create-neko-plugin": "./bin/create-neko-plugin.js"
  },
  "files": [
    "README.md",
    "bin",
    "dist",
    "package.json"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@moeru/std": "catalog:",
    "@nekotech/plugin-protocol": "workspace:^",
    "cac": "catalog:"
  }
}
